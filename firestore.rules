rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Exactly one admin account. Emails containing "admin", "council",
    // "board" or "medical" get NO special access any more.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email == 'user.suniltim@gmail.com'
          || request.auth.token.email.lower() == 'user.suniltim@gmail.com'
        );
    }

    // A user may submit KYC for review, but can never approve themselves.
    function kycIsSelfServe(data) {
      return !('kyc' in data)
        || (data.kyc.kycStatus in ['unsubmitted', 'pending']
            && !('approvedAt' in data.kyc)
            && !('approvedBy' in data.kyc));
    }

    function ownerCreateOk(data) {
      return (!('isAdmin' in data) || data.isAdmin == false)
        && kycIsSelfServe(data);
    }

    function ownerUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['isAdmin'])
        && (!changed.hasAny(['kyc']) || kycIsSelfServe(request.resource.data));
    }

    // Practitioner profile, KYC and saved cases: owner + admin only
    match /profiles/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && ownerCreateOk(request.resource.data)) || isAdmin();
      allow update: if (isOwner(userId) && ownerUpdateOk()) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Mirror user record: same protections
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && ownerCreateOk(request.resource.data)) || isAdmin();
      allow update: if (isOwner(userId) && ownerUpdateOk()) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Case records: only the clinician who saved them, plus admin
    match /cases/{caseId} {
      allow read:   if isAdmin()
                    || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if signedIn()
                    && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
      allow delete: if isAdmin()
                    || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Connection check only; nobody can write here
    match /test/{docId} {
      allow read:  if docId == 'connection';
      allow write: if false;
    }

    // Everything else is denied by default.
  }
}
