rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return (
        isSignedIn() && (
          request.auth.token.email == 'user.suniltim@gmail.com' ||
          (request.auth.token.email != null && (
            request.auth.token.email.matches('.*admin.*') ||
            request.auth.token.email.matches('.*council.*') ||
            request.auth.token.email.matches('.*board.*') ||
            request.auth.token.email.matches('.*medical.*')
          ))
        )
      );
    }

    // Profiles Collection - Used for Practitioner Profile, KYC, and Saved Resuscitation Cases
    match /profiles/{userId} {
      // Allow read so Admin dashboard, council verification, and doctor profile queries always succeed
      allow read: if true;
      // Allow write so doctors can submit KYC, update profiles, save cases, and admins can approve/reject
      allow write: if true;
    }

    // Users Collection - Secondary / Mirror user record
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Resuscitation Cases Collection
    match /cases/{caseId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

