rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Exactly one admin account. Emails containing "admin", "council",
    // "board" or "medical" get NO special access any more.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'user.suniltim@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function kycIsSelfServe(data) {
      return !('kyc' in data)
        || (data.kyc.kycStatus in ['unsubmitted', 'pending']
            && !('approvedAt' in data.kyc)
            && !('approvedBy' in data.kyc));
    }

    function ownerCreateOk(data) {
      return (!('isAdmin' in data) || data.isAdmin == false)
        && kycIsSelfServe(data);
    }

    function ownerUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['isAdmin'])
        && (!changed.hasAny(['kyc']) || kycIsSelfServe(request.resource.data));
    }

    // Practitioner profile and KYC.
    match /profiles/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && ownerCreateOk(request.resource.data)) || isAdmin();
      allow update: if (isOwner(userId) && ownerUpdateOk()) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Mirror user record: same protections.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && ownerCreateOk(request.resource.data)) || isAdmin();
      allow update: if (isOwner(userId) && ownerUpdateOk()) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Canonical case storage. Cases are isolated by authenticated UID.
      match /cases/{caseId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if isOwner(userId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Legacy/global case records retained for backward compatibility while
    // existing installations migrate to users/{uid}/cases/{caseId}.
    match /cases/{caseId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
                    && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if signedIn()
                    && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
      allow delete: if isAdmin()
                    || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Admin-only: lets the admin panel read every doctor's cases in one
    // collection-group query (users/*/cases and the old top-level /cases).
    // Doctors still only reach their own cases through the rules above.
    match /{path=**}/cases/{caseId} {
      allow read: if isAdmin();
    }

    match /test/{docId} {
      allow read: if docId == 'connection';
      allow write: if false;
    }
  }
}
